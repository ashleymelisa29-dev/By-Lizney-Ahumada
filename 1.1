<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { padding: 8px 16px 50px; background: #fff; color: #1a1a1a; font-family: Helvetica, Arial, sans-serif; }

  /* ===== Barra superior: pestañas + carrito ===== */
  .barra { max-width: 420px; margin: 0 auto 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tab { border: 1px solid #ccc; background: #fff; border-radius: 20px; padding: 8px 14px; font-size: 13px; cursor: pointer; color: #333; }
  .tab.activo { background: #8b639b; border-color: #8b639b; color: #fff; }
  .carrito-btn { border: 1.5px solid #8b639b; background: #fff; color: #8b639b; border-radius: 20px; padding: 7px 14px; font-size: 15px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .carrito-btn span { background: #8b639b; color: #fff; border-radius: 10px; padding: 1px 8px; font-size: 13px; margin-left: 4px; }

  /* ===== CELULAR (por defecto): una columna, compacto ===== */
  .producto { max-width: 420px; margin: 0 auto; }
  .foto { position: relative; width: 72%; aspect-ratio: 1 / 1; background: #fafafa; border-radius: 6px; overflow: hidden; margin: 0 auto 10px; }
  .foto img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; }
  h1 { font-size: 22px; font-weight: 500; text-transform: uppercase; line-height: 1.15; margin: 0 0 6px; letter-spacing: .5px; }
  .precio { font-size: 20px; font-weight: 700; color: #8b639b; margin: 0 0 10px; }
  hr { border: none; border-top: 1px solid #e3e3e3; margin: 0 0 10px; }
  .etiqueta { font-size: 15px; margin: 0 0 8px; }
  .etiqueta b { font-weight: 700; margin-right: 6px; }
  .colores { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
  .color { width: 34px; height: 34px; border-radius: 50%; border: none; padding: 0; cursor: pointer; outline: 2px solid transparent; outline-offset: 3px; }
  .color.activo { outline-color: #1a1a1a; }
  .cantidad { display: inline-flex; align-items: center; border: 1px solid #d5d5d5; border-radius: 6px; margin-bottom: 12px; }
  .cantidad button { width: 46px; height: 40px; border: none; background: none; font-size: 22px; cursor: pointer; }
  .cantidad span { min-width: 44px; text-align: center; font-size: 16px; }
  .boton { display: block; width: 100%; background: #8b639b; color: #fff; text-align: center; border: none; cursor: pointer;
    padding: 15px 10px; border-radius: 6px; font-size: 15px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; font-family: inherit; }
  .boton:hover { background: #74507f; }
  .boton.desactivado { opacity: .45; pointer-events: none; }
  .aviso { min-height: 20px; margin: 8px 0 0; font-size: 14px; color: #3b7d4f; text-align: center; font-weight: 700; }

  /* ===== Panel del carrito ===== */
  #panel { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #fff; z-index: 10; overflow-y: auto; padding: 14px 16px 40px; }
  #panel.abierto { display: block; }
  .panel-in { max-width: 460px; margin: 0 auto; }
  .panel-cab { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .panel-cab h2 { margin: 0; font-size: 20px; text-transform: uppercase; font-weight: 600; }
  .cerrar { border: none; background: #f1f1f1; border-radius: 50%; width: 36px; height: 36px; font-size: 18px; cursor: pointer; }
  .item { display: grid; grid-template-columns: 64px 1fr auto; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; }
  .item img { width: 64px; height: 64px; object-fit: contain; background: #fafafa; border-radius: 6px; }
  .item-info { font-size: 14px; display: flex; flex-direction: column; gap: 4px; }
  .item-info span { color: #666; font-size: 13px; }
  .mini { display: inline-flex; align-items: center; border: 1px solid #d5d5d5; border-radius: 6px; width: max-content; }
  .mini button { width: 30px; height: 28px; border: none; background: none; font-size: 16px; cursor: pointer; }
  .mini span { min-width: 26px; text-align: center; color: #1a1a1a; font-size: 14px; }
  .item-der { text-align: right; font-size: 14px; display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
  .quitar { border: none; background: none; color: #b50018; font-size: 12px; cursor: pointer; text-decoration: underline; padding: 0; }
  .vacio { text-align: center; color: #777; padding: 30px 0; font-size: 15px; }
  .total { display: flex; justify-content: space-between; font-size: 18px; font-weight: 700; margin: 16px 0; }
  .total span:last-child { color: #8b639b; }
  .seguir { display: block; width: 100%; margin-top: 10px; background: none; border: none; color: #8b639b; font-size: 14px; cursor: pointer; text-decoration: underline; font-family: inherit; }

  /* ===== COMPUTADOR (bloque ancho): dos columnas ===== */
  @media (min-width: 700px) {
    body { padding: 16px 24px; }
    .barra { max-width: 860px; }
    .producto { max-width: 860px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .foto { width: 100%; margin: 0; max-width: 400px; }
    h1 { font-size: 22px; margin: 6px 0 8px; }
    .precio { font-size: 16px; margin: 0 0 18px; }
    hr { display: none; }
    .etiqueta { font-size: 12px; margin: 0 0 10px; }
    .colores { gap: 10px; margin-bottom: 18px; }
    .color { width: 24px; height: 24px; outline-offset: 2px; }
    .cantidad button { width: 34px; height: 34px; font-size: 16px; }
    .cantidad span { min-width: 40px; font-size: 12px; }
    .cantidad { margin-bottom: 18px; }
    .boton { padding: 13px 10px; font-size: 11px; letter-spacing: 2px; border-radius: 4px; }
  }
</style>
</head>
<body>

<div class="barra">
  <div class="tabs" id="tabs"></div>
  <button class="carrito-btn" onclick="abrirCarrito()">🛒<span id="badge">0</span></button>
</div>

<div class="producto">
  <div class="foto"><img id="foto" alt="" referrerpolicy="no-referrer"></div>
  <div class="info">
    <h1 id="titulo"></h1>
    <p class="precio" id="precio"></p>
    <hr>
    <p class="etiqueta"><b>Color:</b><span id="nombre"></span></p>
    <div class="colores" id="colores"></div>
    <p class="etiqueta"><b>Cantidad:</b></p>
    <div class="cantidad">
      <button onclick="cambiarCant(-1)">&minus;</button>
      <span id="cant">1</span>
      <button onclick="cambiarCant(1)">+</button>
    </div>
    <button class="boton" onclick="anadir()">Añadir al carrito</button>
    <p class="aviso" id="aviso"></p>
  </div>
</div>

<!-- Carrito -->
<div id="panel">
  <div class="panel-in">
    <div class="panel-cab">
      <h2>Tu carrito</h2>
      <button class="cerrar" onclick="cerrarCarrito()" aria-label="Cerrar">&times;</button>
    </div>
    <div id="lista"></div>
    <div class="total"><span>Total</span><span id="total">$0 COP</span></div>
    <a class="boton desactivado" id="finalizar" href="#" target="_blank">Finalizar pedido</a>
    <button class="seguir" onclick="cerrarCarrito()">Seguir comprando</button>
  </div>
</div>

<script>
  // Tu número de WhatsApp con indicativo de país, sin + ni espacios (Colombia = 57)
  var WHATSAPP = "573002665909";

  var PRODUCTOS = {
    lazo: {
      nombre: "Lazo", precio: 7000,
      colores: [
        { n: "Rojo",           c: "#b50018", id: "1JtPtPAskSKxQ0zMSWw50Hgx47GOg8ZZj" },
        { n: "Rojo oscuro",    c: "#900010", id: "1yF70BJoU1bzBCWb5_JGEV51_-n6W6irI" },
        { n: "Naranja",        c: "#f26325", id: "1OSntRxdhv6JrJ4d-CQ7VUQ2alzACFZKt" },
        { n: "Amarillo",       c: "#dfa60e", id: "19yXo9tuyIaH5-RlSwwL3v-A9oPJjc8bQ" },
        { n: "Amarillo claro", c: "#d9b552", id: "18v9zD9EAsf4inDbF-1Ir-RMNJxyUd8sz" },
        { n: "Verde claro",    c: "#b0cea5", id: "1_HAq_UO2eJfJ3eIRSRULGYzIMHO8MtHd" },
        { n: "Verde oscuro",   c: "#10653e", id: "13OLplM2ALoEWcwa2ROmP7h9rLGYcgGrk" },
        { n: "Azul",           c: "#6d9dbb", id: "13v3RSMY6jAgbeAYuXZmk8bSOqRZUp89E" },
        { n: "Morado",         c: "#9b8ec7", id: "1u831ktbNalIBdyyvSg7nrw0HNtDiHUff" },
        { n: "Rosado",         c: "#e88e94", id: "1nrXCr7EbjIH4kwxuff9W9rdJxQlFKHm5" }
      ]
    },
    rosas: {
      nombre: "Rosas colgantes", precio: 8000,
      colores: [
        { n: "Rojo",           c: "#b50018", id: "1XDu1SgqZngCp-ZgP8SSnAmW6nH3lx7Tp" },
        { n: "Rojo oscuro",    c: "#900010", id: "1Kyu6RWPgmzL60ic3S6Ik2DntpC4F7J_W" },
        { n: "Naranja",        c: "#f26325", id: "1peMz1fwBrU6RADxA1YvmAwKH7K4zzex2" },
        { n: "Amarillo",       c: "#dfa60e", id: "1Dsl1wGVtfZXl1hiQs1_e7uz4C4HSgpT4" },
        { n: "Amarillo claro", c: "#d9b552", id: "15TuCVHhC8bOkTgnhfr031yVowCoerWSX" },
        { n: "Verde claro",    c: "#b0cea5", id: "1IZrpiuXSvOfMFbDjzw8HVCUMFPPa0EqK" },
        { n: "Azul",           c: "#6d9dbb", id: "117hp-oMJ0DttlH0rDk8-9H_tgKkDL6tw" },
        { n: "Lila",           c: "#9b8ec7", id: "1bDt0APBFD_Xb3_4MqqwZJ1ohSC0Oj3_C" },
        { n: "Rosado",         c: "#e88e94", id: "1Wsa-xRJaQowfkKQW7s_phLuhYYbguip2" }
      ]
    }
  };
  var ORDEN = ["lazo", "rosas"];

  var prodActual = "lazo", colorIdx = 0, cantidad = 1, carrito = [];
  var foto = document.getElementById("foto");

  function fmt(n) { return "$" + n.toLocaleString("es-CO") + " COP"; }

  function setImg(img, id, sz) {
    var ops = [
      "https://drive.google.com/thumbnail?id=" + id + "&sz=w" + sz,
      "https://lh3.googleusercontent.com/d/" + id,
      "https://drive.google.com/uc?export=view&id=" + id
    ], i = 0;
    img.onerror = function () { i++; if (i < ops.length) img.src = ops[i]; };
    img.src = ops[0];
  }

  /* ---------- Guardado (si el navegador lo permite) ---------- */
  function guardar() { try { localStorage.setItem("carritoLA", JSON.stringify(carrito)); } catch (e) {} }
  function cargarGuardado() {
    try {
      var d = JSON.parse(localStorage.getItem("carritoLA") || "[]");
      for (var i = 0; i < d.length; i++) {
        var p = PRODUCTOS[d[i].p];
        if (p && p.colores[d[i].c] && d[i].q > 0) carrito.push({ p: d[i].p, c: d[i].c, q: d[i].q });
      }
    } catch (e) {}
  }

  /* ---------- Producto ---------- */
  function pintarTabs() {
    var t = document.getElementById("tabs"); t.innerHTML = "";
    ORDEN.forEach(function (k) {
      var b = document.createElement("button");
      b.className = "tab" + (k === prodActual ? " activo" : "");
      b.textContent = PRODUCTOS[k].nombre;
      b.onclick = function () { mostrarProducto(k); };
      t.appendChild(b);
    });
  }

  function mostrarProducto(k) {
    prodActual = k; colorIdx = 0; cantidad = 1;
    document.getElementById("cant").textContent = 1;
    var p = PRODUCTOS[k];
    document.getElementById("titulo").textContent = p.nombre;
    document.getElementById("precio").textContent = fmt(p.precio);
    foto.alt = p.nombre;
    var cont = document.getElementById("colores"); cont.innerHTML = "";
    p.colores.forEach(function (col, i) {
      var b = document.createElement("button");
      b.className = "color" + (i === 0 ? " activo" : "");
      b.style.background = col.c; b.title = col.n;
      b.onclick = function () { elegirColor(i); };
      cont.appendChild(b);
    });
    pintarTabs();
    elegirColor(0);
  }

  function elegirColor(i) {
    colorIdx = i;
    var col = PRODUCTOS[prodActual].colores[i];
    var bs = document.querySelectorAll("#colores .color");
    for (var k = 0; k < bs.length; k++) bs[k].classList.toggle("activo", k === i);
    document.getElementById("nombre").textContent = col.n;
    setImg(foto, col.id, 1000);
  }

  function cambiarCant(d) {
    cantidad = Math.max(1, cantidad + d);
    document.getElementById("cant").textContent = cantidad;
  }

  /* ---------- Carrito ---------- */
  function anadir() {
    var ya = null;
    for (var i = 0; i < carrito.length; i++) {
      if (carrito[i].p === prodActual && carrito[i].c === colorIdx) ya = carrito[i];
    }
    if (ya) ya.q += cantidad; else carrito.push({ p: prodActual, c: colorIdx, q: cantidad });
    guardar(); actualizarBadge();
    var col = PRODUCTOS[prodActual].colores[colorIdx].n.toLowerCase();
    document.getElementById("aviso").textContent = "✓ Añadido: " + cantidad + " × " + PRODUCTOS[prodActual].nombre.toLowerCase() + " " + col;
    cantidad = 1; document.getElementById("cant").textContent = 1;
    setTimeout(function () { document.getElementById("aviso").textContent = ""; }, 2500);
  }

  function actualizarBadge() {
    var n = 0; for (var i = 0; i < carrito.length; i++) n += carrito[i].q;
    document.getElementById("badge").textContent = n;
  }

  function abrirCarrito() { renderCarrito(); document.getElementById("panel").classList.add("abierto"); }
  function cerrarCarrito() { document.getElementById("panel").classList.remove("abierto"); }

  function cambiarItem(i, d) { carrito[i].q = Math.max(1, carrito[i].q + d); guardar(); actualizarBadge(); renderCarrito(); }
  function quitar(i) { carrito.splice(i, 1); guardar(); actualizarBadge(); renderCarrito(); }

  function renderCarrito() {
    var lista = document.getElementById("lista"), html = "", total = 0, lineas = [];
    if (!carrito.length) html = '<p class="vacio">Tu carrito está vacío 🛒</p>';
    for (var i = 0; i < carrito.length; i++) {
      var it = carrito[i], p = PRODUCTOS[it.p], c = p.colores[it.c], sub = p.precio * it.q;
      total += sub;
      lineas.push("• " + it.q + " x " + p.nombre + " " + c.n.toLowerCase() + " - " + fmt(sub));
      html += '<div class="item"><img data-id="' + c.id + '" referrerpolicy="no-referrer" alt="">' +
        '<div class="item-info"><b>' + p.nombre + '</b><span>Color: ' + c.n + '</span>' +
        '<div class="mini"><button onclick="cambiarItem(' + i + ',-1)">&minus;</button><span>' + it.q + '</span><button onclick="cambiarItem(' + i + ',1)">+</button></div></div>' +
        '<div class="item-der"><b>' + fmt(sub) + '</b><button class="quitar" onclick="quitar(' + i + ')">Quitar</button></div></div>';
    }
    lista.innerHTML = html;
    var imgs = lista.querySelectorAll("img[data-id]");
    for (var k = 0; k < imgs.length; k++) setImg(imgs[k], imgs[k].getAttribute("data-id"), 200);

    document.getElementById("total").textContent = fmt(total);
    var f = document.getElementById("finalizar");
    if (carrito.length) {
      var msg = "Hola, quiero hacer este pedido:\n" + lineas.join("\n") + "\n\nTotal: " + fmt(total);
      f.href = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(msg);
      f.classList.remove("desactivado");
    } else {
      f.href = "#"; f.classList.add("desactivado");
    }
  }

  /* ---------- Inicio ---------- */
  cargarGuardado();
  actualizarBadge();
  mostrarProducto("lazo");
  // Precarga de imágenes
  ORDEN.forEach(function (k) {
    PRODUCTOS[k].colores.forEach(function (c) { new Image().src = "https://drive.google.com/thumbnail?id=" + c.id + "&sz=w1000"; });
  });
</script>

</body>
</html>
